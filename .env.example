# ═══════════════════════════════════════════════════════════════════════════
# Marketing-Team — Autonomous AI Reels & Posts Agent (.env configuration)
# ═══════════════════════════════════════════════════════════════════════════

# 1. VELONA.IN TEXT-TO-TEXT API (One key for 300+ models, billed in ₹ INR)
# Get your key at: https://velona.in/keys (UPI top-up from ₹10)
VELONA_API_KEY=
VELONA_BASE_URL=https://velona.in/v1
VELONA_GATEWAY_URL=https://velona.in/gateway/v1
LLM_MODEL=anthropic/claude-sonnet-4-6

# 2. SINGLE FACEBOOK TOKEN -> AUTO-LINKS INSTAGRAM BUSINESS ACCOUNT
# Because your Facebook Page is linked to your Instagram Professional account,
# ONE Facebook Page Access Token controls both Facebook Page & Instagram!
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0
PUBLIC_VIDEO_BASE_URL=

# 3. NICHE & COMMENT-TO-DM MONETIZATION FUNNEL
PROFILE_HANDLE=@ai.wealth.builder
NICHE="AI Agents, Tech Automation & Side Hustle Monetization"
TARGET_AUDIENCE="Creators, developers & entrepreneurs looking to automate content and earn online"
BRAND_VOICE="Direct, high-clarity, proof-driven, zero fluff, actionable"
MONETIZATION_OFFER="AI Automation Blueprint + Ready-to-Use Templates (₹499)"
MONETIZATION_URL=https://velona.in/?ref=ai-agent-blueprint
DM_TRIGGER_KEYWORD=AUTO

# 4. AUTOPILOT MODE ("hybrid_dashboard" | "full_autopilot" | "review_first")
AUTOMATION_MODE=hybrid_dashboard
PORT=3000
